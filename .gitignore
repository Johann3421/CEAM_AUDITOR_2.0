# =============================================================================
# CEAM AUDITOR 2.0 — Root Git Ignore
# =============================================================================

# --- OS & IDEs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/

# --- Python Bytecode & Caches ---
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.pytest_cache/
backend/.venv/
backend/env/
backend/venv/
backend/.env
backend/alembic/env.py.bak
*.db
*.log

# --- Frontend (Node) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env
frontend/.env.development
frontend/.env.production
frontend/.eslintcache

# --- Docker & DB ---
postgres_data/
redis_data/
*.sql
*.tar
docker-compose.override.yml

# --- Playwright & Scraper Scratch ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
scratch/
tmp/
*.dump
*_dump.json
*.xlsx

# --- Ephemeral image captures ---
after_buscar.png
before_buscar.png
mejoraplazo*.png
captcha_*.png
debug_shot.png
backend/*.png

# Scripts temporales y volcados locales
scripts/

# --- Integraciones ---
!integrations/
!integrations/n8n/
!integrations/n8n/*.json
